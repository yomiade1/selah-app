# Line endings: LF in the repository and in working copies, so scripts run unchanged on Linux,
# macOS and in CI. Windows tools (PowerShell, .NET, Git for Windows) all accept LF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.db binary
*.sqlite binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.pdf binary
