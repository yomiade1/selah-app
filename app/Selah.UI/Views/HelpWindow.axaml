<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Selah.UI.ViewModels"
        xmlns:pb="using:Selah.Contracts.V1"
        xmlns:s="using:Selah.UI.Services"
        x:Class="Selah.UI.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Title="{Binding [help-title], Source={x:Static s:Localizer.Instance}}"
        Width="980" Height="720" MinWidth="520" MinHeight="420">
  <!-- Help in its own window, so it never covers the preview or the live controls (§5.4). -->
  <DockPanel Margin="{DynamicResource Space.Text.Large}">
    <StackPanel DockPanel.Dock="Top" Spacing="{DynamicResource Space.3}">
      <TextBlock Name="SearchLabel" Classes="label" Text="{Binding [help-search-label], Source={x:Static s:Localizer.Instance}}" />
      <TextBlock Classes="hint" Text="{Binding [help-search-hint], Source={x:Static s:Localizer.Instance}}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding SearchCommand}" IsDefault="True">
          <TextBlock Text="{Binding [help-search-button], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <TextBox Name="SearchBox" Text="{Binding Query}" AutomationProperties.LabeledBy="{Binding #SearchLabel}" />
      </DockPanel>
      <TextBlock Classes="hint" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding Message}" />
    </StackPanel>
    <Grid ColumnDefinitions="Auto,*" Margin="{DynamicResource Space.Text.Small}">
      <ListBox Name="Results" Width="{DynamicResource Size.SidebarWidth}" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="pb:Article">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding Title}" />
              <TextBlock Classes="caption" Text="{Binding Summary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1" Name="ArticleScroller" Padding="{DynamicResource Space.Text.Large}">
        <ContentControl Name="ArticleHost" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
