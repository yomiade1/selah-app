<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Selah.UI.Views.EmptyState">
  <Border Classes="card">
    <StackPanel Spacing="{DynamicResource Space.3}">
      <TextBlock Name="TitleBlock" Classes="title-3" TextWrapping="Wrap" />
      <TextBlock Name="DescriptionBlock" Classes="hint" TextWrapping="Wrap" />
      <WrapPanel ItemSpacing="{DynamicResource Space.3}" LineSpacing="{DynamicResource Space.2}" VerticalAlignment="Center">
        <Button Name="ActionButton" Classes="primary" Click="OnActionClick">
          <TextBlock Name="ActionButtonText" />
        </Button>
        <Button Name="LearnHowButton" Classes="link" Click="OnLearnHowClick">
          <TextBlock Name="LearnHowTextBlock" TextDecorations="Underline" />
        </Button>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
