<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Selah.UI.ViewModels"
        xmlns:pb="using:Selah.Contracts.V1"
        xmlns:views="using:Selah.UI.Views"
        xmlns:s="using:Selah.UI.Services"
        x:Class="Selah.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding [app-name], Source={x:Static s:Localizer.Instance}}"
        Width="1280" Height="800" MinWidth="640" MinHeight="480">
  <DockPanel>
    <!-- Safe mode (SAFE-07, DESIGN-SYSTEM §10): a warning alert that can't be dismissed. -->
    <Border Name="SafeModeBanner" DockPanel.Dock="Top" IsVisible="{Binding IsSafeMode}"
            s:Help.Anchor="shell.safe-mode-banner"
            Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}"
            BorderThickness="{DynamicResource Line.AlertBar}" Padding="{DynamicResource Space.Text.Medium}">
      <WrapPanel ItemSpacing="{DynamicResource Space.4}" LineSpacing="{DynamicResource Space.3}">
        <TextBlock Name="SafeModeMessage" Classes="label" VerticalAlignment="Center" views:Critical.IsCritical="True"
                   Text="{Binding [safe-mode-message], Source={x:Static s:Localizer.Instance}}" />
        <Button Name="SafeModeLearnWhy" Click="OnSafeModeLearnWhy"
                Content="{Binding [safe-mode-learn-why], Source={x:Static s:Localizer.Instance}}" />
        <Button Name="SafeModeRestart" Command="{Binding RestartNormallyCommand}"
                ToolTip.Tip="{Binding [safe-mode-restart-hint], Source={x:Static s:Localizer.Instance}}"
                Content="{Binding [safe-mode-restart], Source={x:Static s:Localizer.Instance}}" />
      </WrapPanel>
    </Border>

    <!-- Toolbar. Clear everything is always here, and wraps to a new line rather than shrink. -->
    <Border Name="Toolbar" DockPanel.Dock="Top" MinHeight="{DynamicResource Size.ToolbarHeight}"
            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="{DynamicResource Line.Bottom}" Padding="{DynamicResource Space.Text.Medium}">
      <WrapPanel ItemSpacing="{DynamicResource Space.4}" LineSpacing="{DynamicResource Space.3}" VerticalAlignment="Center">
        <TextBlock Classes="title-3" VerticalAlignment="Center" TextWrapping="NoWrap"
                   Text="{Binding [app-name], Source={x:Static s:Localizer.Instance}}" />
        <Border Name="StatusPill" Classes="pill" VerticalAlignment="Center"
                s:Help.Anchor="shell.status"
                Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="{DynamicResource Line.Hairline}">
          <TextBlock Name="StatusText" Classes="label" TextWrapping="NoWrap" views:Critical.IsCritical="True"
                     Text="{Binding StatusText}" />
        </Border>
        <Border Name="LiveTag" Classes="pill" IsVisible="{Binding IsLive}" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Live}">
          <TextBlock Classes="tag" Foreground="{DynamicResource Brush.OnPrimary}" views:Critical.IsCritical="True"
                     Text="{Binding [preview-live], Source={x:Static s:Localizer.Instance}}" />
        </Border>
        <Button Name="ModePreviewButton" IsEnabled="{Binding CanChangeMode}" Classes.primary="{Binding IsPreviewMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="Preview">
          <TextBlock Text="{Binding [mode-preview], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ModeLibraryButton" IsEnabled="{Binding CanChangeMode}" Classes.primary="{Binding IsLibraryMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="Library">
          <TextBlock Text="{Binding [mode-library], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ModeSongEditorButton" IsEnabled="{Binding CanChangeMode}" Classes.primary="{Binding IsSongEditorMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="SongEditor">
          <TextBlock Text="{Binding [mode-song-editor], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ModeSlideEditorButton" IsEnabled="{Binding CanChangeMode}" Classes.primary="{Binding IsSlideEditorMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="SlideEditor">
          <TextBlock Text="{Binding [mode-slide-editor], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ModeTemplatesButton" IsEnabled="{Binding CanChangeMode}" Classes.primary="{Binding IsTemplatesMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="Templates">
          <TextBlock Text="{Binding [mode-templates], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ModeServicePlannerButton" IsEnabled="{Binding CanChangeMode}" Classes.primary="{Binding IsServicePlannerMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="ServicePlanner">
          <TextBlock Text="{Binding [mode-services], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ModeLiveButton" Classes.primary="{Binding IsLiveMode}"
                Command="{Binding SelectModeCommand}" CommandParameter="Live" s:Help.Anchor="live.producer">
          <TextBlock Text="{Binding [mode-live], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <!-- Simple / Producer (prototypes 01, 02). A role-locked volunteer can't open Producer (SEC-14). -->
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsLiveMode}" Spacing="{DynamicResource Space.1}" s:Help.Anchor="simple.controls">
          <Button Name="LiveSimpleViewButton" Classes.primary="{Binding IsSimpleMode}"
                  Command="{Binding SelectLiveViewCommand}" CommandParameter="Simple">
            <TextBlock Text="{Binding [live-mode-simple], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="LiveProducerViewButton" Classes.primary="{Binding !IsSimpleMode}" IsEnabled="{Binding CanChangeMode}"
                  Command="{Binding SelectLiveViewCommand}" CommandParameter="Producer">
            <TextBlock Text="{Binding [live-mode-producer], Source={x:Static s:Localizer.Instance}}" />
          </Button>
        </StackPanel>
        <Button Name="CommandPaletteButton" Classes="quiet" Command="{Binding OpenCommandPaletteCommand}"
                s:Help.Anchor="shell.command-palette"
                ToolTip.Tip="{Binding [command-search-hint], Source={x:Static s:Localizer.Instance}}">
          <TextBlock Text="{Binding [command-search], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ShowTestPatternButton" Classes="primary" Command="{Binding ShowTestPatternCommand}"
                s:Help.Anchor="shell.show-test-pattern"
                ToolTip.Tip="{Binding [command-show-test-pattern-hint], Source={x:Static s:Localizer.Instance}}">
          <TextBlock Text="{Binding [command-show-test-pattern], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ClearEverythingButton" Classes="emergency" Command="{Binding ClearEverythingCommand}"
                s:Help.Anchor="shell.clear-everything"
                ToolTip.Tip="{Binding [command-clear-everything-hint], Source={x:Static s:Localizer.Instance}}">
          <TextBlock views:Critical.IsCritical="True"
                     Text="{Binding [command-clear-everything], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="SettingsButton" Classes="quiet" Click="OnOpenSettings">
          <TextBlock Text="{Binding [command-settings], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <!-- Help menu (M1.13, M2.8): For this screen (F1), What's this? (Shift+F1), articles, Report a problem, Diagnostics. -->
        <Button Name="HelpMenuButton" Classes="quiet"
                s:Help.Anchor="help.report-a-problem"
                ToolTip.Tip="{Binding [command-help-hint], Source={x:Static s:Localizer.Instance}}">
          <TextBlock Text="{Binding [command-help], Source={x:Static s:Localizer.Instance}}" />
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Name="HelpForScreenItem" Click="OnHelpForScreen"
                        Header="{Binding [help-for-this-screen-menu], Source={x:Static s:Localizer.Instance}}" />
              <MenuItem Name="WhatsThisMenuItem" Click="OnToggleWhatsThis"
                        Header="{Binding [help-whats-this-menu], Source={x:Static s:Localizer.Instance}}" />
              <MenuItem Name="StartTourItem" Command="{Binding Tour.ShowPickerCommand}"
                        Header="{Binding [tour-start], Source={x:Static s:Localizer.Instance}}" />
              <MenuItem Name="HelpArticlesItem" Click="OnOpenHelp"
                        Header="{Binding [sidebar-help-articles], Source={x:Static s:Localizer.Instance}}" />
              <MenuItem Name="ReportProblemItem" Command="{Binding ReportProblemCommand}"
                        Header="{Binding [command-report-problem], Source={x:Static s:Localizer.Instance}}" />
              <MenuItem Name="DiagnosticsItem" Click="OnOpenDiagnostics"
                        Header="{Binding [command-diagnostics], Source={x:Static s:Localizer.Instance}}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>
    </Border>

    <!-- SAFE-06: quitting or updating while something is on the screens asks first. It sits under
         the toolbar, so it never covers the preview or Clear everything (DESIGN-SYSTEM §1). -->
    <Border Name="LiveGuardBar" DockPanel.Dock="Top" IsVisible="{Binding IsLiveGuardOpen}"
            Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}"
            BorderThickness="{DynamicResource Line.AlertBar}" Padding="{DynamicResource Space.Text.Medium}">
      <WrapPanel ItemSpacing="{DynamicResource Space.4}" LineSpacing="{DynamicResource Space.3}">
        <StackPanel Spacing="{DynamicResource Space.1}" VerticalAlignment="Center">
          <TextBlock Name="LiveGuardTitle" Classes="label" views:Critical.IsCritical="True"
                     Text="{Binding [live-guard-title], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock Name="LiveGuardQuestion" TextWrapping="Wrap" Text="{Binding LiveGuardQuestion}" />
        </StackPanel>
        <Button Name="LiveGuardKeep" Classes="primary" Command="{Binding CancelLiveGuardCommand}" IsDefault="True" IsCancel="True">
          <TextBlock views:Critical.IsCritical="True"
                     Text="{Binding [live-guard-keep], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LiveGuardConfirm" Command="{Binding ConfirmLiveGuardCommand}">
          <TextBlock Text="{Binding LiveGuardConfirmText}" />
        </Button>
      </WrapPanel>
    </Border>

    <!-- Help ▸ Report a problem (M1.13): where the support file is, under the toolbar. -->
    <Border Name="ReportBar" DockPanel.Dock="Top" IsVisible="{Binding IsReportOpen}"
            s:Help.Anchor="help.report-a-problem"
            Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="{DynamicResource Line.Bottom}" Padding="{DynamicResource Space.Text.Medium}">
      <WrapPanel ItemSpacing="{DynamicResource Space.4}" LineSpacing="{DynamicResource Space.3}">
        <StackPanel Spacing="{DynamicResource Space.1}" VerticalAlignment="Center">
          <TextBlock Name="ReportMessage" TextWrapping="Wrap" Text="{Binding ReportMessage}" />
          <SelectableTextBlock Name="ReportPath" Classes="hint" TextWrapping="Wrap" Text="{Binding ReportPath}"
                               IsVisible="{Binding HasReportFile}" />
        </StackPanel>
        <Button Name="ReportShowFile" Command="{Binding ShowReportFileCommand}" IsVisible="{Binding HasReportFile}">
          <TextBlock Text="{Binding [report-show-file], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ReportOpenForm" Command="{Binding OpenReportFormCommand}" IsVisible="{Binding HasReportFile}">
          <TextBlock Text="{Binding [report-open-form], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="ReportClose" Classes="quiet" Command="{Binding CloseReportCommand}">
          <TextBlock Text="{Binding [report-close], Source={x:Static s:Localizer.Instance}}" />
        </Button>
      </WrapPanel>
    </Border>

    <!-- What's this? (Shift+F1) non-blocking inspection bar & popover, never covering Toolbar or Preview. -->
    <views:WhatsThisOverlay Name="WhatsThisControl" DockPanel.Dock="Top"
                            IsActive="{Binding IsWhatsThisActive, Mode=TwoWay}"
                            Closed="OnWhatsThisClosed" />

    <!-- Plain-language shell error alert with "How to fix" link. -->
    <views:ErrorAlert Name="MainErrorAlert" DockPanel.Dock="Top"
                      Margin="12,6,12,0"
                      Message="{Binding LastError}"
                      FixArticleId="{Binding LastErrorFixArticleId}" />

    <!-- M4.7 first-run setup. -->
    <Border Name="SetupPanel" DockPanel.Dock="Top" IsVisible="{Binding Setup.IsOpen}" Classes="card"
            Margin="{DynamicResource Space.Text.Small}" s:Help.Anchor="setup.wizard">
      <StackPanel Spacing="{DynamicResource Space.2}" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Classes="title-3" Text="{Binding [setup-title], Source={x:Static s:Localizer.Instance}}" />
        <TextBlock Classes="caption" Text="{Binding Setup.StepText}" />
        <TextBlock TextWrapping="Wrap" IsVisible="{Binding Setup.IsWelcome}" Text="{Binding [setup-intro], Source={x:Static s:Localizer.Instance}}" />
        <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding Setup.IsScreens}">
          <TextBlock Classes="label" Text="{Binding [setup-screens-title], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding [setup-screens-hint], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding Setup.HasScreens}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding [setup-screens-none], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding !Setup.HasScreens}" />
          <ItemsControl ItemsSource="{Binding Setup.Screens}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pb:OutputConfig">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding Setup.IsBible}">
          <TextBlock Classes="label" Text="{Binding [setup-bible-title], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding [setup-bible-hint], Source={x:Static s:Localizer.Instance}}" />
          <ComboBox Name="SetupBibleCombo" MinWidth="200" ItemsSource="{Binding Setup.Bibles}" SelectedItem="{Binding Setup.SelectedBible}"
                    AutomationProperties.Name="{Binding [setup-bible-title], Source={x:Static s:Localizer.Instance}}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pb:BibleTranslation">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding Setup.IsCcli}" s:Help.Anchor="setup.ccli">
          <TextBlock Classes="label" Text="{Binding [setup-ccli-label], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding [setup-ccli-hint], Source={x:Static s:Localizer.Instance}}" />
          <TextBox Name="SetupCcliBox" MaxLength="12" MaxWidth="240" HorizontalAlignment="Left" Text="{Binding Setup.CcliNumber}"
                   AutomationProperties.Name="{Binding [setup-ccli-label], Source={x:Static s:Localizer.Instance}}" />
        </StackPanel>
        <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding Setup.IsSample}">
          <TextBlock Classes="label" Text="{Binding [setup-sample-title], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding [setup-sample-hint], Source={x:Static s:Localizer.Instance}}" />
          <Button Name="SetupAddSampleButton" Command="{Binding Setup.AddSampleCommand}" IsEnabled="{Binding !Setup.SampleAdded}">
            <TextBlock Text="{Binding [setup-sample-add], Source={x:Static s:Localizer.Instance}}" />
          </Button>
        </StackPanel>
        <TextBlock Name="SetupStatus" TextWrapping="Wrap" Text="{Binding Setup.StatusText}"
                   IsVisible="{Binding Setup.StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}">
          <Button Name="SetupBackButton" Command="{Binding Setup.BackCommand}" IsEnabled="{Binding Setup.CanGoBack}">
            <TextBlock Text="{Binding [setup-back], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SetupNextButton" Classes="primary" Command="{Binding Setup.NextCommand}" IsVisible="{Binding Setup.IsNotLastStep}">
            <TextBlock Text="{Binding [setup-next], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SetupFinishButton" Classes="primary" Command="{Binding Setup.FinishCommand}" IsVisible="{Binding Setup.IsLastStep}">
            <TextBlock Text="{Binding [setup-finish], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SetupSkipButton" Classes="quiet" Command="{Binding Setup.SkipCommand}">
            <TextBlock Text="{Binding [setup-skip], Source={x:Static s:Localizer.Instance}}" />
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Sidebar: an Apple-style source list. -->
    <Border Name="Sidebar" DockPanel.Dock="Left" Width="{DynamicResource Size.SidebarWidth}"
            Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="{DynamicResource Line.Right}" Padding="{DynamicResource Space.Text.Medium}">
      <ScrollViewer>
        <StackPanel Spacing="{DynamicResource Space.2}">
          <TextBlock Classes="caption" Text="{Binding [sidebar-heading-plan], Source={x:Static s:Localizer.Instance}}" />
          <Button Name="SidebarPreviewButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding SelectModeCommand}" CommandParameter="Preview">
            <TextBlock Text="{Binding [sidebar-services], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarSongsButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding OpenLibraryTabCommand}" CommandParameter="Songs">
            <TextBlock Text="{Binding [sidebar-songs], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarMediaButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding OpenLibraryTabCommand}" CommandParameter="Media">
            <TextBlock Text="{Binding [sidebar-media], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarBiblesButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding OpenLibraryTabCommand}" CommandParameter="Bibles">
            <TextBlock Text="{Binding [sidebar-bibles], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarSongEditorButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding SelectModeCommand}" CommandParameter="SongEditor">
            <TextBlock Text="{Binding [mode-song-editor], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarSlideEditorButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding SelectModeCommand}" CommandParameter="SlideEditor">
            <TextBlock Text="{Binding [mode-slide-editor], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarTemplatesButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding SelectModeCommand}" CommandParameter="Templates">
            <TextBlock Text="{Binding [mode-templates], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="SidebarServicePlannerButton" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding SelectModeCommand}" CommandParameter="ServicePlanner">
            <TextBlock Text="{Binding [mode-services], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <TextBlock Classes="caption" Margin="0,8,0,0" Text="{Binding [sidebar-heading-help], Source={x:Static s:Localizer.Instance}}" />
          <Button Name="HelpArticlesButton" Classes="quiet" Click="OnOpenHelp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <TextBlock Text="{Binding [sidebar-help-articles], Source={x:Static s:Localizer.Instance}}" />
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Contextual Help panel (F1, KNOWLEDGE-BASE §5.2): docked below Toolbar so Preview & Clear stay uncovered. -->
    <views:HelpPanelView Name="HelpPanelControl" DockPanel.Dock="Right"
                         DataContext="{Binding HelpPanel}"
                         s:Help.Anchor="shell.help-panel" />

    <!-- Inspector skeleton (Preview mode only when Help panel isn't open; Editor/Library own their own workspace inspector). -->
    <Border Name="Inspector" DockPanel.Dock="Right" Width="{DynamicResource Size.InspectorWidth}"
            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="{DynamicResource Line.Left}" Padding="{DynamicResource Space.Text.Medium}">
      <StackPanel Spacing="{DynamicResource Space.3}">
        <TextBlock Classes="title-3" Text="{Binding [inspector-heading], Source={x:Static s:Localizer.Instance}}" />
        <views:HintText Text="{Binding [inspector-empty], Source={x:Static s:Localizer.Instance}}" />
      </StackPanel>
    </Border>

    <!-- Main workspace below the toolbar: Preview, Library, Song Editor, plus Ctrl+K palette overlay. -->
    <Panel>
      <!-- Program and Staged Previews: never covered while live (DESIGN-SYSTEM §1, M3.6). -->
      <Grid Name="PreviewWorkspace" IsVisible="{Binding IsPreviewMode}" RowDefinitions="Auto,*" Margin="{DynamicResource Space.Text.Medium}"
            s:Help.Anchor="shell.preview">
        <Border Grid.Row="0" Classes="alert-warning" IsVisible="{Binding HasPreviewFlashWarning}" Margin="0,0,0,8">
          <TextBlock Name="PreviewFlashWarningText" Text="{Binding [preview-flash-warning], Source={x:Static s:Localizer.Instance}}" />
        </Border>

        <Grid Name="PreviewDualGrid" Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*" ColumnSpacing="12" RowSpacing="12">
          <!-- Program (live output) ring -->
          <Border Name="ProgramPreviewCard" Grid.Column="0" Grid.Row="0" Classes="card"
                  BorderBrush="{DynamicResource Brush.Live}" BorderThickness="2">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <WrapPanel Grid.Row="0" ItemSpacing="{DynamicResource Space.2}" VerticalAlignment="Center">
                <TextBlock Classes="title-3" VerticalAlignment="Center" Text="{Binding [preview-on-screen], Source={x:Static s:Localizer.Instance}}" />
                <Border Classes="pill" IsVisible="{Binding IsLive}" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Live}">
                  <TextBlock Classes="tag" Foreground="{DynamicResource Brush.OnPrimary}"
                             Text="{Binding [preview-live], Source={x:Static s:Localizer.Instance}}" />
                </Border>
                <views:InfoButton Name="PreviewInfoButton" Anchor="shell.preview" />
              </WrapPanel>
              <Viewbox Grid.Row="1" Stretch="Uniform">
                <Grid Name="ProgramPreviewSurface" Width="480" Height="270">
                  <Rectangle Fill="{DynamicResource Brush.PreviewBg}" />
                  <Image Name="PreviewImage" Stretch="Uniform" />
                </Grid>
              </Viewbox>
              <views:HintText Grid.Row="2" IsVisible="{Binding !IsLive}"
                              Text="{Binding [preview-nothing], Source={x:Static s:Localizer.Instance}}" />
            </Grid>
          </Border>

          <!-- Staged preview (next) ring -->
          <Border Name="StagePreviewCard" Grid.Column="1" Grid.Row="0" Classes="card"
                  BorderBrush="{DynamicResource Brush.Success}" BorderThickness="2">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <WrapPanel Grid.Row="0" ItemSpacing="{DynamicResource Space.2}" VerticalAlignment="Center">
                <TextBlock Classes="title-3" VerticalAlignment="Center" Text="{Binding [preview-staged-heading], Source={x:Static s:Localizer.Instance}}" />
                <Border Classes="pill" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Success}">
                  <TextBlock Classes="tag" Foreground="{DynamicResource Brush.OnPrimary}"
                             Text="{Binding [preview-staged-tag], Source={x:Static s:Localizer.Instance}}" />
                </Border>
              </WrapPanel>
              <Viewbox Grid.Row="1" Stretch="Uniform">
                <Grid Name="StagePreviewSurface" Width="480" Height="270">
                  <Rectangle Fill="{DynamicResource Brush.PreviewBg}" />
                  <Image Name="StagePreviewImage" Stretch="Uniform" />
                </Grid>
              </Viewbox>
              <views:HintText Grid.Row="2" IsVisible="{Binding !HasStagedPreview}"
                              Text="{Binding [preview-staged-nothing], Source={x:Static s:Localizer.Instance}}" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Panel Name="LibraryWorkspace" IsVisible="{Binding IsLibraryMode}">
        <views:LibraryView Name="LibraryViewControl" DataContext="{Binding Library}" />
      </Panel>

      <Panel Name="SongEditorWorkspace" IsVisible="{Binding IsSongEditorMode}">
        <views:SongEditorView Name="SongEditorViewControl" DataContext="{Binding SongEditor}" />
      </Panel>

      <Panel Name="SlideEditorWorkspace" IsVisible="{Binding IsSlideEditorMode}">
        <views:SlideEditorView Name="SlideEditorViewControl" DataContext="{Binding SlideEditor}" />
      </Panel>

      <Panel Name="TemplatesWorkspace" IsVisible="{Binding IsTemplatesMode}">
        <views:TemplateEditorView Name="TemplateEditorViewControl" DataContext="{Binding TemplateEditor}" />
      </Panel>

      <Panel Name="ServicePlannerWorkspace" IsVisible="{Binding IsServicePlannerMode}">
        <views:ServicePlannerView Name="ServicePlannerViewControl" DataContext="{Binding ServicePlanner}" />
      </Panel>

      <!-- Live: Producer mode (M4.4). -->
      <Panel Name="LiveWorkspace" IsVisible="{Binding IsLiveMode}">
        <views:LiveProducerView Name="LiveProducerViewControl" DataContext="{Binding LiveProducer}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsProducerView}" />
        <views:SimpleModeView Name="SimpleModeViewControl" DataContext="{Binding Simple}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsSimpleView}" />
      </Panel>

      <!-- M4.7: practice banner and tour coach marks float at the top of the workspace, on the side
           away from the program preview, so they never push or cover Next and Clear (DESIGN-SYSTEM §1). -->
      <StackPanel Name="GuideOverlay" VerticalAlignment="Top" HorizontalAlignment="{Binding GuideAlignment}"
                  MaxWidth="560" Margin="{DynamicResource Space.Text.Small}" Spacing="{DynamicResource Space.1}" ZIndex="10">
      <!-- M4.7 practice mode: says plainly that nothing reaches the room. Docked, never on top. -->
      <Border Name="PracticeBanner" IsVisible="{Binding IsPracticeMode}"
              Background="{DynamicResource Brush.WarningBg}" BorderBrush="{DynamicResource Brush.Warning}"
              BorderThickness="{DynamicResource Line.AlertBar}" Padding="{DynamicResource Space.Text.Small}"
              s:Help.Anchor="live.practice-mode">
        <!-- One line, so the live controls keep their room at 200% text; Stop practice is in the toolbar. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space.3}">
          <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding [live-practice-banner], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding [live-practice-banner-detail], Source={x:Static s:Localizer.Instance}}"
                     ToolTip.Tip="{Binding [live-practice-banner-detail], Source={x:Static s:Localizer.Instance}}" />
        </Grid>
      </Border>

      <!-- M4.7 tours: the picker and one coach mark at a time, docked so nothing live is covered. -->
      <Border Name="TourBar" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="{DynamicResource Line.AlertBar}"
              Padding="{DynamicResource Space.Text.Small}" IsVisible="{Binding Tour.IsVisible}" s:Help.Anchor="help.tour">
        <StackPanel Spacing="{DynamicResource Space.2}">
          <StackPanel Name="TourPicker" Spacing="{DynamicResource Space.2}" IsVisible="{Binding Tour.IsPicking}">
            <TextBlock Classes="label" Text="{Binding [tour-pick], Source={x:Static s:Localizer.Instance}}" />
            <ItemsControl Name="TourList" ItemsSource="{Binding Tour.Tours}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TourDefinition">
                  <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tour.StartCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Title}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="TourRefusal" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Live}" Text="{Binding Tour.Refusal}"
                       IsVisible="{Binding Tour.Refusal, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Name="TourPickerClose" Classes="quiet" Command="{Binding Tour.SkipCommand}">
              <TextBlock Text="{Binding [tour-skip], Source={x:Static s:Localizer.Instance}}" />
            </Button>
          </StackPanel>
          <Grid Name="TourCoachMark" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space.3}" IsVisible="{Binding Tour.IsOpen}">
            <TextBlock Name="TourStepText" TextWrapping="Wrap" VerticalAlignment="Center">
              <Run FontWeight="SemiBold" Text="{Binding Tour.StepCounter}" />
              <Run Text="{Binding Tour.StepText}" />
            </TextBlock>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}">
              <Button Name="TourBackButton" Command="{Binding Tour.BackCommand}" IsEnabled="{Binding Tour.CanGoBack}">
                <TextBlock Text="{Binding [tour-back], Source={x:Static s:Localizer.Instance}}" />
              </Button>
              <Button Name="TourNextButton" Classes="primary" Command="{Binding Tour.NextCommand}">
                <TextBlock Text="{Binding Tour.NextText}" />
              </Button>
              <Button Name="TourSkipButton" Classes="quiet" Command="{Binding Tour.SkipCommand}">
                <TextBlock Text="{Binding [tour-skip], Source={x:Static s:Localizer.Instance}}" />
              </Button>
            </WrapPanel>
          </Grid>
        </StackPanel>
      </Border>
      </StackPanel>

      <!-- Quick find (Ctrl/Cmd+K) never covers Toolbar / Clear everything. -->
      <views:CommandPaletteView Name="CommandPaletteControl" DataContext="{Binding CommandPalette}"
                                s:Help.Anchor="shell.command-palette" />
    </Panel>
  </DockPanel>
</Window>
