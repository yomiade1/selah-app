<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Selah.UI.ViewModels"
        xmlns:views="using:Selah.UI.Views"
        xmlns:s="using:Selah.UI.Services"
        x:Class="Selah.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding [settings-title], Source={x:Static s:Localizer.Instance}}"
        Width="820" Height="720" MinWidth="480" MinHeight="400">
  <views:SettingsView />
</Window>
