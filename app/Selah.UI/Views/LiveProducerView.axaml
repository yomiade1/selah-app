<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Selah.UI.ViewModels"
             xmlns:pb="using:Selah.Contracts.V1"
             xmlns:views="using:Selah.UI.Views"
             xmlns:s="using:Selah.UI.Services"
             xmlns:dock="using:Dock.Avalonia.Controls"
             x:Class="Selah.UI.Views.LiveProducerView"
             x:DataType="vm:LiveProducerViewModel"
             Focusable="True">
  <DockPanel>
    <!-- Bottom: the live controls. Docked first so they keep their space at any text size;
         nothing covers these (DESIGN-SYSTEM §10). -->
    <Border Name="LiveControlBar" DockPanel.Dock="Bottom" Padding="{DynamicResource Space.Text.Small}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="{DynamicResource Line.Hairline}"
            Background="{DynamicResource Brush.Surface}" s:Help.Anchor="live.controls">
      <WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}">
        <Button Name="LiveClearAllButton" Classes="emergency" Command="{Binding ClearAllCommand}">
          <TextBlock views:Critical.IsCritical="True" Text="{Binding [live-clear-all-key], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LivePreviousButton" Command="{Binding PreviousCommand}">
          <TextBlock views:Critical.IsCritical="True" Text="{Binding [live-previous], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LiveNextButton" Classes="primary" Command="{Binding NextCommand}">
          <TextBlock views:Critical.IsCritical="True" Text="{Binding [live-next-key], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LiveClearTextButton" Command="{Binding ClearTextCommand}">
          <TextBlock views:Critical.IsCritical="True" Text="{Binding [live-clear-text-key-bar], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LiveClearBackgroundButton" Command="{Binding ClearBackgroundCommand}">
          <TextBlock Text="{Binding [live-clear-background-key-bar], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LiveShowLogoButton" Command="{Binding ShowLogoCommand}">
          <TextBlock Text="{Binding [live-show-logo-key], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LiveNextItemButton" Command="{Binding NextItemCommand}">
          <TextBlock Text="{Binding [live-next-item-key], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <Button Name="LivePracticeButton" Classes.primary="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsPracticeMode}"
                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).TogglePracticeCommand}" s:Help.Anchor="live.practice-mode">
          <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).PracticeButtonText}" />
        </Button>
        <Button Name="LiveUndoButton" Classes="quiet" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}">
          <TextBlock Text="{Binding [live-undo-key], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <ItemsControl Name="LiveHealthBar" ItemsSource="{Binding Health}" VerticalAlignment="Center" s:Help.Anchor="live.health">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="{DynamicResource Space.3}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LiveHealthItem">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.1}">
                <Ellipse Width="{DynamicResource Space.3}" Height="{DynamicResource Space.3}" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Success}" IsVisible="{Binding Ok}" />
                <Ellipse Width="{DynamicResource Space.3}" Height="{DynamicResource Space.3}" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Warning}" IsVisible="{Binding !Ok}" />
                <TextBlock Classes="caption" Text="{Binding Name}" />
                <TextBlock Classes="caption" Text="{Binding StateText}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
    </Border>

    <!-- Top: which service, layout and booth lock. -->
    <Border DockPanel.Dock="Top" Padding="{DynamicResource Space.Text.Small}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="{DynamicResource Line.Bottom}">
      <WrapPanel ItemSpacing="{DynamicResource Space.3}" LineSpacing="{DynamicResource Space.2}" s:Help.Anchor="live.producer">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Name="LiveServiceNameText" Classes="title-3" Text="{Binding ServiceName}" />
          <TextBlock Name="LiveLookTag" Classes="caption" IsVisible="{Binding ActiveLookName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding ActiveLookName}" />
        </StackPanel>
        <ComboBox Name="LiveServicePicker" MinWidth="200" VerticalAlignment="Center"
                  ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                  AutomationProperties.Name="{Binding [live-choose-service], Source={x:Static s:Localizer.Instance}}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="pb:Service">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="LiveLoadServiceButton" Command="{Binding GoLiveWithServiceCommand}">
          <TextBlock Text="{Binding [live-load-service], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <ComboBox Name="LiveLayoutPicker" MinWidth="160" VerticalAlignment="Center" s:Help.Anchor="live.layout"
                  ItemsSource="{Binding LayoutPresets}" SelectionChanged="OnLayoutPresetChosen"
                  PlaceholderText="{Binding [live-layout], Source={x:Static s:Localizer.Instance}}"
                  AutomationProperties.Name="{Binding [live-layout], Source={x:Static s:Localizer.Instance}}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProducerLayoutState">
              <TextBlock Text="{Binding Name, Converter={x:Static views:LayoutNameConverter.Instance}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="LiveSaveLayoutButton" Classes="quiet" Command="{Binding SaveLayoutCommand}">
          <TextBlock Text="{Binding [live-layout-save], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <ToggleButton Name="LiveBoothLockButton" IsChecked="{Binding IsBoothLocked, Mode=OneWay}"
                      Command="{Binding ToggleBoothLockCommand}" s:Help.Anchor="live.booth-lock">
          <TextBlock Text="{Binding [live-booth-lock], Source={x:Static s:Localizer.Instance}}" />
        </ToggleButton>
        <!-- SEC-14: lock this computer to Simple mode with a PIN. -->
        <Button Name="LiveRoleLockButton" Command="{Binding StartLockCommand}" IsVisible="{Binding !IsLocking}" s:Help.Anchor="live.role-lock">
          <TextBlock Text="{Binding [role-lock-turn-on], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.2}" IsVisible="{Binding IsLocking}" s:Help.Anchor="live.role-lock">
          <TextBox Name="LiveRoleLockPinBox" MinWidth="120" MaxLength="8" PasswordChar="•" Text="{Binding LockPin}"
                   AutomationProperties.Name="{Binding [role-lock-pin], Source={x:Static s:Localizer.Instance}}"
                   Watermark="{Binding [role-lock-pin], Source={x:Static s:Localizer.Instance}}"
                   ToolTip.Tip="{Binding [role-lock-pin-hint], Source={x:Static s:Localizer.Instance}}" />
          <Button Name="LiveRoleLockConfirmButton" Classes="primary" Command="{Binding LockCommand}">
            <TextBlock Text="{Binding [role-lock-turn-on], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <Button Name="LiveRoleLockCancelButton" Classes="quiet" Command="{Binding CancelLockCommand}">
            <TextBlock Text="{Binding [simple-booth-message-cancel], Source={x:Static s:Localizer.Instance}}" />
          </Button>
        </StackPanel>
        <views:InfoButton Name="LiveProducerInfoButton" Anchor="live.producer" />
      </WrapPanel>
    </Border>

    <!-- SAFE-06: the booth lock banner. -->
    <Border Name="LiveBoothLockedBanner" DockPanel.Dock="Top" Classes="alert-warning" IsVisible="{Binding IsBoothLocked}">
      <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding [live-booth-locked-banner], Source={x:Static s:Localizer.Instance}}" />
    </Border>
    <!-- SAFE-01: Message the booth reaches the operator only, here. -->
    <Border Name="LiveBoothMessageAlert" DockPanel.Dock="Top" Classes="alert-warning" IsVisible="{Binding HasBoothMessage}">
      <DockPanel>
        <Button Name="LiveBoothMessageDismiss" DockPanel.Dock="Right" Classes="quiet" Command="{Binding DismissBoothMessageCommand}">
          <TextBlock Text="{Binding [live-booth-message-dismiss], Source={x:Static s:Localizer.Instance}}" />
        </Button>
        <TextBlock Name="LiveBoothMessageText" Classes="label" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding BoothMessage}" />
      </DockPanel>
    </Border>
    <views:ErrorAlert Name="LiveErrorAlert" DockPanel.Dock="Top" Message="{Binding ErrorText}" FixArticleId="{Binding ErrorFixArticleId}" />

    <!-- Screen readers hear what is on screen (DESIGN-SYSTEM §9). -->
    <TextBlock Name="LiveAnnouncement" DockPanel.Dock="Bottom" Height="0" Text="{Binding Announcement}"
               AutomationProperties.LiveSetting="Polite" />

    <dock:DockControl Name="LiveDock" Layout="{Binding DockLayout}" InitializeLayout="True" InitializeFactory="True">
      <dock:DockControl.DataTemplates>
        <DataTemplate DataType="vm:ServiceOrderPane">
          <DockPanel s:Help.Anchor="live.service-order">
            <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="{DynamicResource Space.Text.Small}" IsVisible="{Binding !Live.HasService}"
                       TextWrapping="Wrap" Text="{Binding [live-empty-service-action], Source={x:Static s:Localizer.Instance}}" />
            <ScrollViewer>
              <ItemsControl Name="LiveServiceOrderList" ItemsSource="{Binding Live.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveItemRow">
                    <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Classes.primary="{Binding IsLive}" IsEnabled="{Binding !IsHeader}"
                            Command="{Binding $parent[ItemsControl].((vm:ServiceOrderPane)DataContext).Live.TriggerItemCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.2}">
                        <TextBlock Classes="label" Text="{Binding KindGlyph}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Classes="label" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="tag" Text="{Binding StateText}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:SlidesPane">
          <DockPanel s:Help.Anchor="live.slides">
            <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Space.Text.Small}">
              <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Primary}" Text="{Binding Live.CurrentItemEyebrow}" />
              <TextBlock Name="LiveCurrentTitle" Classes="title-2" Text="{Binding Live.CurrentItemTitle}" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="{Binding Live.NextText}" TextWrapping="Wrap" />
              <TextBlock Classes="hint" Text="{Binding [live-hotkeys-hint], Source={x:Static s:Localizer.Instance}}" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl Name="LiveSlideGrid" ItemsSource="{Binding Live.Slides}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="{DynamicResource Space.3}" LineSpacing="{DynamicResource Space.3}" Margin="{DynamicResource Space.Text.Small}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LiveSlideCard">
                    <Button Width="208" Padding="0" Classes.primary="{Binding IsLive}"
                            Command="{Binding $parent[ItemsControl].((vm:SlidesPane)DataContext).Live.TriggerSlideCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel>
                        <Border Height="117" Background="{DynamicResource Brush.PreviewBg}" CornerRadius="{DynamicResource Radius.Card}" Padding="{DynamicResource Space.Text.Small}">
                          <TextBlock Foreground="{DynamicResource Brush.SlideText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                     Text="{Binding Text}" />
                        </Border>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space.1}" Margin="{DynamicResource Space.Text.Small}">
                          <Ellipse Width="{DynamicResource Space.3}" Height="{DynamicResource Space.3}" Fill="{Binding SectionColor}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Classes="tag" Text="{Binding StateText}" />
                          <TextBlock Grid.Column="3" Classes="caption" Text="{Binding Number}" />
                        </Grid>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ProgramPane">
          <DockPanel s:Help.Anchor="live.program-preview" Margin="{DynamicResource Space.Text.Small}">
            <TextBlock DockPanel.Dock="Top" Classes="label" Text="{Binding [live-pane-program], Source={x:Static s:Localizer.Instance}}" />
            <Viewbox Stretch="Uniform">
              <Border Width="480" Height="270" Background="{DynamicResource Brush.PreviewBg}" BorderBrush="{DynamicResource Brush.Live}"
                      BorderThickness="{DynamicResource Line.Emphasis}">
                <Image Name="LiveProgramImage" Source="{Binding Live.ProgramFrame}" Stretch="Uniform" />
              </Border>
            </Viewbox>
          </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:LayersPane">
          <ScrollViewer s:Help.Anchor="live.layers">
            <ItemsControl Name="LiveLayersList" ItemsSource="{Binding Live.Layers}" Margin="{DynamicResource Space.Text.Small}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LiveLayerRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.2}" Margin="{DynamicResource Space.Item}">
                    <Border Width="{DynamicResource Space.1}" Background="{DynamicResource Brush.Success}" IsVisible="{Binding IsActive}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="label" Text="{Binding Name}" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding $parent[ItemsControl].((vm:LayersPane)DataContext).Live.ClearLayerCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding ClearText}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="vm:TilesPane">
          <ScrollViewer s:Help.Anchor="live.tiles">
            <ItemsControl Name="LiveTilesList" ItemsSource="{Binding Live.Tiles}" Margin="{DynamicResource Space.Text.Small}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LiveTile">
                  <Button MinWidth="120" Classes.primary="{Binding IsOn}"
                          Command="{Binding $parent[ItemsControl].((vm:TilesPane)DataContext).Live.ActivateTileCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.1}">
                        <TextBlock Classes="caption" Text="{Binding Caption}" />
                        <TextBlock Classes="caption" Text="{Binding Hotkey}" IsVisible="{Binding HasHotkey}" />
                      </StackPanel>
                      <TextBlock Classes="label" Text="{Binding Value}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:TilesSetupPane">
          <ScrollViewer s:Help.Anchor="live.setup-tiles">
            <StackPanel Name="TilesEditor" Spacing="{DynamicResource Space.2}" Margin="{DynamicResource Space.Text.Small}"
                        DataContext="{Binding Live.TilesSetup}" x:DataType="vm:TilesEditorViewModel">
              <TextBlock Classes="label" Text="{Binding [tiles-title], Source={x:Static s:Localizer.Instance}}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [tiles-hint], Source={x:Static s:Localizer.Instance}}" />

              <TextBlock Classes="caption" Text="{Binding [tiles-kind], Source={x:Static s:Localizer.Instance}}" />
              <ComboBox Name="TilesKindCombo" MinWidth="160" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                        AutomationProperties.Name="{Binding [tiles-kind], Source={x:Static s:Localizer.Instance}}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShowControlKindOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Classes="caption" Text="{Binding [tiles-saved-list], Source={x:Static s:Localizer.Instance}}" />
              <WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}">
                <ComboBox Name="TilesSavedCombo" MinWidth="160" ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSaved}"
                          IsVisible="{Binding !HasNoSaved}" AutomationProperties.Name="{Binding [tiles-saved-list], Source={x:Static s:Localizer.Instance}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShowControl"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding [tiles-saved-none], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding HasNoSaved}" />
                <Button Name="TilesNewButton" Command="{Binding NewCommand}"><TextBlock Text="{Binding [tiles-new], Source={x:Static s:Localizer.Instance}}" /></Button>
              </WrapPanel>

              <TextBlock Classes="caption" Text="{Binding [tiles-name], Source={x:Static s:Localizer.Instance}}" />
              <TextBox Name="TilesName" Text="{Binding Name}" MaxLength="80" AutomationProperties.Name="{Binding [tiles-name], Source={x:Static s:Localizer.Instance}}" />
              <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding HasKey}">
                <TextBlock Classes="caption" Text="{Binding [tiles-key], Source={x:Static s:Localizer.Instance}}" />
                <TextBox Name="TilesKey" Text="{Binding Key}" MaxLength="1" MinWidth="80" HorizontalAlignment="Left" AutomationProperties.Name="{Binding [tiles-key], Source={x:Static s:Localizer.Instance}}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [tiles-key-hint], Source={x:Static s:Localizer.Instance}}" />
              </StackPanel>

              <!-- Look: which layers each audience screen shows. -->
              <StackPanel Name="TilesLookFields" Spacing="{DynamicResource Space.1}" IsVisible="{Binding IsLook}">
                <TextBlock Classes="caption" Text="{Binding [tiles-look-screens], Source={x:Static s:Localizer.Instance}}" />
                <ItemsControl ItemsSource="{Binding ScreenRules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LookScreenRow">
                      <StackPanel Spacing="{DynamicResource Space.1}">
                        <TextBlock Classes="label" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Layers}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemSpacing="{DynamicResource Space.2}" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerChoice">
                              <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Prop and message: the words and how long they stay up. -->
              <StackPanel Name="TilesWordsFields" Spacing="{DynamicResource Space.1}" IsVisible="{Binding HasWords}">
                <TextBlock Classes="caption" Text="{Binding [tiles-prop-words], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding IsProp}" />
                <TextBlock Classes="caption" Text="{Binding [tiles-message-text], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding IsMessage}" />
                <TextBox Name="TilesWords" Text="{Binding Words}" MaxLength="200" TextWrapping="Wrap"
                         AutomationProperties.Name="{Binding [tiles-prop-words], Source={x:Static s:Localizer.Instance}}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [tiles-prop-words-hint], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding IsProp}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [tiles-message-text-hint], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding IsMessage}" />
                <TextBlock Classes="caption" Text="{Binding [tiles-hide-after], Source={x:Static s:Localizer.Instance}}" />
                <NumericUpDown Name="TilesHideAfter" Minimum="0" Maximum="3600" Increment="5" FormatString="0" Value="{Binding HideAfterSeconds}"
                               MinWidth="110" HorizontalAlignment="Left" AutomationProperties.Name="{Binding [tiles-hide-after], Source={x:Static s:Localizer.Instance}}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [tiles-hide-after-hint], Source={x:Static s:Localizer.Instance}}" />
                <CheckBox Name="TilesStageOnly" IsChecked="{Binding StageOnly}" IsVisible="{Binding IsMessage}" Content="{Binding [tiles-message-stage-only], Source={x:Static s:Localizer.Instance}}" />
              </StackPanel>

              <!-- Timer. -->
              <StackPanel Name="TilesTimerFields" Spacing="{DynamicResource Space.1}" IsVisible="{Binding IsTimer}">
                <TextBlock Classes="caption" Text="{Binding [tiles-timer-kind], Source={x:Static s:Localizer.Instance}}" />
                <ComboBox Name="TilesTimerKind" MinWidth="160" ItemsSource="{Binding TimerKinds}" SelectedItem="{Binding SelectedTimerKind}"
                          AutomationProperties.Name="{Binding [tiles-timer-kind], Source={x:Static s:Localizer.Instance}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimerKindOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding UsesMinutes}">
                  <TextBlock Classes="caption" Text="{Binding [tiles-timer-minutes], Source={x:Static s:Localizer.Instance}}" />
                  <NumericUpDown Name="TilesTimerMinutes" Minimum="1" Maximum="600" Increment="1" FormatString="0" Value="{Binding Minutes}"
                                 MinWidth="110" HorizontalAlignment="Left" AutomationProperties.Name="{Binding [tiles-timer-minutes], Source={x:Static s:Localizer.Instance}}" />
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding UsesTimeOfDay}">
                  <TextBlock Classes="caption" Text="{Binding [tiles-timer-time], Source={x:Static s:Localizer.Instance}}" />
                  <TextBox Name="TilesTimerTime" Text="{Binding TimeOfDay}" MaxLength="5" MinWidth="110" HorizontalAlignment="Left"
                           AutomationProperties.Name="{Binding [tiles-timer-time], Source={x:Static s:Localizer.Instance}}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding [tiles-timer-at-zero], Source={x:Static s:Localizer.Instance}}" />
                <ComboBox Name="TilesTimerOverrun" MinWidth="160" ItemsSource="{Binding OverrunOptions}" SelectedItem="{Binding SelectedOverrun}"
                          AutomationProperties.Name="{Binding [tiles-timer-at-zero], Source={x:Static s:Localizer.Instance}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverrunOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding RunsMacroAtZero}">
                  <TextBlock Classes="caption" Text="{Binding [tiles-timer-macro], Source={x:Static s:Localizer.Instance}}" />
                  <ComboBox Name="TilesTimerMacro" MinWidth="160" ItemsSource="{Binding Macros}" SelectedItem="{Binding OverrunMacro}"
                            AutomationProperties.Name="{Binding [tiles-timer-macro], Source={x:Static s:Localizer.Instance}}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="pb:Macro"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </StackPanel>

              <!-- Macro: its steps, in order. -->
              <StackPanel Name="TilesMacroFields" Spacing="{DynamicResource Space.1}" IsVisible="{Binding IsMacro}">
                <TextBlock Classes="caption" Text="{Binding [tiles-macro-steps], Source={x:Static s:Localizer.Instance}}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [tiles-macro-steps-none], Source={x:Static s:Localizer.Instance}}" IsVisible="{Binding !HasSteps}" />
                <ItemsControl Name="TilesMacroSteps" ItemsSource="{Binding Steps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroStepRow">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space.1}">
                        <TextBlock Classes="label" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text}" />
                        <Button Grid.Column="1" Command="{Binding $parent[ItemsControl].((vm:TilesEditorViewModel)DataContext).MoveStepUpCommand}"
                                CommandParameter="{Binding}"><TextBlock Text="{Binding [tiles-macro-move-up], Source={x:Static s:Localizer.Instance}}" /></Button>
                        <Button Grid.Column="2" Command="{Binding $parent[ItemsControl].((vm:TilesEditorViewModel)DataContext).RemoveStepCommand}"
                                CommandParameter="{Binding}"><TextBlock Text="{Binding [tiles-macro-remove-step], Source={x:Static s:Localizer.Instance}}" /></Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption" Text="{Binding [tiles-macro-step], Source={x:Static s:Localizer.Instance}}" />
                <ComboBox Name="TilesStepKind" MinWidth="160" ItemsSource="{Binding StepKinds}" SelectedItem="{Binding SelectedStepKind}"
                          AutomationProperties.Name="{Binding [tiles-macro-step], Source={x:Static s:Localizer.Instance}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroStepOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="{DynamicResource Space.1}" IsVisible="{Binding StepNeedsTarget}">
                  <TextBlock Classes="caption" Text="{Binding [tiles-macro-step-target], Source={x:Static s:Localizer.Instance}}" />
                  <ComboBox Name="TilesStepTarget" MinWidth="160" ItemsSource="{Binding StepTargets}" SelectedItem="{Binding SelectedStepTarget}"
                            AutomationProperties.Name="{Binding [tiles-macro-step-target], Source={x:Static s:Localizer.Instance}}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StepTarget"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Button Name="TilesAddStep" HorizontalAlignment="Left" Command="{Binding AddStepCommand}"><TextBlock Text="{Binding [tiles-macro-add-step], Source={x:Static s:Localizer.Instance}}" /></Button>
              </StackPanel>

              <!-- Clear group: what one tile clears. -->
              <StackPanel Name="TilesClearFields" Spacing="{DynamicResource Space.1}" IsVisible="{Binding IsClearGroup}">
                <TextBlock Classes="caption" Text="{Binding [tiles-clear-layers], Source={x:Static s:Localizer.Instance}}" />
                <ItemsControl ItemsSource="{Binding ClearLayers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="{DynamicResource Space.2}" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerChoice"><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Name="TilesClearAudio" IsChecked="{Binding StopAudio}" Content="{Binding [tiles-clear-stop-audio], Source={x:Static s:Localizer.Instance}}" />
                <CheckBox Name="TilesClearTimers" IsChecked="{Binding StopTimers}" Content="{Binding [tiles-clear-stop-timers], Source={x:Static s:Localizer.Instance}}" />
                <CheckBox Name="TilesClearLogo" IsChecked="{Binding HideLogo}" Content="{Binding [tiles-clear-hide-logo], Source={x:Static s:Localizer.Instance}}" />
              </StackPanel>

              <WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}">
                <Button Name="TilesSaveButton" Classes="primary" Command="{Binding SaveCommand}"><TextBlock Text="{Binding [tiles-save], Source={x:Static s:Localizer.Instance}}" /></Button>
                <Button Name="TilesDeleteButton" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}"><TextBlock Text="{Binding [tiles-delete], Source={x:Static s:Localizer.Instance}}" /></Button>
              </WrapPanel>
              <TextBlock Name="TilesStatus" Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}"
                         IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:StagePane">
          <ScrollViewer s:Help.Anchor="live.stage-editor">
            <StackPanel Name="StageEditor" Spacing="{DynamicResource Space.2}" Margin="{DynamicResource Space.Text.Small}"
                        DataContext="{Binding Live.Stage}" x:DataType="vm:StageEditorViewModel">
              <TextBlock Classes="label" Text="{Binding [stage-editor-title], Source={x:Static s:Localizer.Instance}}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding [stage-editor-hint], Source={x:Static s:Localizer.Instance}}" />

              <Viewbox Stretch="Uniform" MaxHeight="220" HorizontalAlignment="Left" s:Help.Anchor="live.stage-preview">
                <Border Name="StagePreview" Width="320" Height="180" Background="{DynamicResource Brush.PreviewBg}" ClipToBounds="True"
                        AutomationProperties.Name="{Binding [stage-editor-preview], Source={x:Static s:Localizer.Instance}}">
                  <ItemsControl ItemsSource="{Binding Preview}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StagePreviewBox">
                        <Border Margin="{Binding Margin}" Width="{Binding Width}" Height="{Binding Height}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="{DynamicResource Line.Hairline}"
                                Background="{DynamicResource Brush.Surface}">
                          <TextBlock Classes="caption" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Viewbox>

              <TextBlock Classes="caption" Text="{Binding [stage-editor-layout], Source={x:Static s:Localizer.Instance}}" />
              <ComboBox Name="StageLayoutCombo" MinWidth="160" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                        AutomationProperties.Name="{Binding [stage-editor-layout], Source={x:Static s:Localizer.Instance}}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="pb:StageLayout">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" Foreground="{DynamicResource Brush.SuccessText}" Text="{Binding InUseText}" IsVisible="{Binding IsInUse}" />

              <TextBlock Classes="caption" Text="{Binding [stage-editor-arrangement], Source={x:Static s:Localizer.Instance}}" />
              <ComboBox Name="StageArrangementCombo" MinWidth="160" ItemsSource="{Binding Arrangements}" SelectedItem="{Binding SelectedArrangement}"
                        AutomationProperties.Name="{Binding [stage-editor-arrangement], Source={x:Static s:Localizer.Instance}}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StageArrangementOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Classes="caption" Text="{Binding [stage-editor-show], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowChords" IsChecked="{Binding ShowChords}" Content="{Binding [stage-editor-chords], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowKey" IsChecked="{Binding ShowKey}" Content="{Binding [stage-editor-key], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowSections" IsChecked="{Binding ShowSections}" Content="{Binding [stage-editor-arrangement-strip], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowClock" IsChecked="{Binding ShowClock}" Content="{Binding [stage-editor-clock], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowNext" IsChecked="{Binding ShowNext}" Content="{Binding [stage-editor-next], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowTimer" IsChecked="{Binding ShowTimer}" Content="{Binding [stage-editor-timer], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowNotes" IsChecked="{Binding ShowNotes}" Content="{Binding [stage-editor-notes], Source={x:Static s:Localizer.Instance}}" />
              <CheckBox Name="StageShowBooth" IsChecked="{Binding ShowBooth}" Content="{Binding [stage-editor-booth], Source={x:Static s:Localizer.Instance}}" />

              <TextBlock Classes="caption" Text="{Binding [stage-editor-text-size], Source={x:Static s:Localizer.Instance}}" />
              <Slider Name="StageTextSize" Minimum="50" Maximum="200" SmallChange="10" LargeChange="25" TickFrequency="25"
                      IsSnapToTickEnabled="False" Value="{Binding TextSize}"
                      AutomationProperties.Name="{Binding [stage-editor-text-size], Source={x:Static s:Localizer.Instance}}" />

              <TextBlock Classes="caption" Text="{Binding [stage-editor-name], Source={x:Static s:Localizer.Instance}}" />
              <TextBox Name="StageLayoutName" Text="{Binding Name}" MaxLength="80"
                       AutomationProperties.Name="{Binding [stage-editor-name], Source={x:Static s:Localizer.Instance}}" />

              <WrapPanel ItemSpacing="{DynamicResource Space.2}" LineSpacing="{DynamicResource Space.2}">
                <Button Name="StageSaveButton" Command="{Binding SaveCommand}">
                  <TextBlock Text="{Binding [stage-editor-save], Source={x:Static s:Localizer.Instance}}" />
                </Button>
                <Button Name="StageUseButton" Classes="primary" Command="{Binding UseCommand}">
                  <TextBlock Text="{Binding [stage-editor-use], Source={x:Static s:Localizer.Instance}}" />
                </Button>
              </WrapPanel>
              <TextBlock Classes="caption" Text="{Binding StatusText}" IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </dock:DockControl.DataTemplates>
    </dock:DockControl>
  </DockPanel>
</UserControl>
