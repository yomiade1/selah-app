<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Selah.UI.ViewModels"
             xmlns:views="using:Selah.UI.Views"
             xmlns:s="using:Selah.UI.Services"
             xmlns:pb="using:Selah.Contracts.V1"
             x:Class="Selah.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- Settings ▸ Appearance (prototype screen 8): appearance, text size with a live preview. -->
  <ScrollViewer>
    <StackPanel Spacing="{DynamicResource Space.6}" Margin="{DynamicResource Space.Text.Large}" MaxWidth="760">
      <TextBlock Classes="title-1" Text="{Binding [settings-title], Source={x:Static s:Localizer.Instance}}" />
      <TextBlock Classes="title-3" Text="{Binding [settings-section-appearance], Source={x:Static s:Localizer.Instance}}" />

      <Border Classes="card" s:Help.Anchor="settings.appearance">
        <StackPanel Spacing="{DynamicResource Space.3}">
          <WrapPanel ItemSpacing="{DynamicResource Space.2}" VerticalAlignment="Center">
            <TextBlock Name="AppearanceLabel" Classes="label" VerticalAlignment="Center" Text="{Binding [appearance-label], Source={x:Static s:Localizer.Instance}}" />
            <views:InfoButton Anchor="settings.appearance" />
          </WrapPanel>
          <views:HintText Text="{Binding [appearance-hint], Source={x:Static s:Localizer.Instance}}" />
          <ListBox Name="AppearanceChoice" SelectedIndex="{Binding AppearanceIndex}" SelectionMode="AlwaysSelected,Single"
                   AutomationProperties.LabeledBy="{Binding #AppearanceLabel}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="{DynamicResource Space.2}" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem>
              <TextBlock TextWrapping="NoWrap" Text="{Binding [appearance-light], Source={x:Static s:Localizer.Instance}}" />
            </ListBoxItem>
            <ListBoxItem>
              <TextBlock TextWrapping="NoWrap" Text="{Binding [appearance-booth], Source={x:Static s:Localizer.Instance}}" />
            </ListBoxItem>
            <ListBoxItem>
              <TextBlock TextWrapping="NoWrap" Text="{Binding [appearance-automatic], Source={x:Static s:Localizer.Instance}}" />
            </ListBoxItem>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Classes="card" s:Help.Anchor="settings.text-size">
        <StackPanel Spacing="{DynamicResource Space.4}">
          <WrapPanel ItemSpacing="{DynamicResource Space.3}" VerticalAlignment="Center">
            <TextBlock Name="TextSizeLabel" Classes="label" VerticalAlignment="Center" Text="{Binding [text-size-label], Source={x:Static s:Localizer.Instance}}" />
            <TextBlock Name="TextSizeName" Classes="label" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Primary}" Text="{Binding TextSizeName}" />
            <TextBlock Name="TextSizeValue" Classes="hint" VerticalAlignment="Center" Text="{Binding TextSizeValue}" />
            <views:InfoButton Anchor="settings.text-size" />
          </WrapPanel>
          <views:HintText Text="{Binding [text-size-hint], Source={x:Static s:Localizer.Instance}}" />
          <Slider Name="TextSizeSlider" Minimum="0" Maximum="{Binding TextSizeMaximum}" TickFrequency="1"
                  IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsEnabled="{Binding CanChooseTextSize}"
                  Value="{Binding TextSizeIndex}" AutomationProperties.LabeledBy="{Binding #TextSizeLabel}" />
          <ToggleSwitch Name="UseComputerTextSize" IsChecked="{Binding UseComputerTextSize}">
            <TextBlock Text="{Binding [text-size-use-computer], Source={x:Static s:Localizer.Instance}}" />
          </ToggleSwitch>
          <views:HintText Text="{Binding [text-size-use-computer-hint], Source={x:Static s:Localizer.Instance}}" />
          <views:HintText Text="{Binding [text-size-shortcuts], Source={x:Static s:Localizer.Instance}}" />

          <!-- The live preview: it uses the app's own type tokens, so it shows the chosen size. -->
          <TextBlock Classes="caption" Text="{Binding [text-size-preview-label], Source={x:Static s:Localizer.Instance}}" />
          <Border Name="TextSizePreview" Background="{DynamicResource Brush.Surface2}" CornerRadius="{DynamicResource Radius.Control}"
                  Padding="{DynamicResource Space.Text.Large}">
            <StackPanel Spacing="{DynamicResource Space.3}">
              <TextBlock Classes="title-3" Text="{Binding [text-size-preview-title], Source={x:Static s:Localizer.Instance}}" />
              <TextBlock Text="{Binding [text-size-preview-body], Source={x:Static s:Localizer.Instance}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Settings ▸ Church (M4.9): the CCLI licence number and the first Bible. -->
      <WrapPanel ItemSpacing="{DynamicResource Space.2}" VerticalAlignment="Center">
        <TextBlock Classes="title-3" VerticalAlignment="Center" Text="{Binding [settings-section-church], Source={x:Static s:Localizer.Instance}}" />
        <views:InfoButton Anchor="settings.church" />
      </WrapPanel>
      <Border Name="ChurchCard" Classes="card" s:Help.Anchor="settings.church">
        <StackPanel Spacing="{DynamicResource Space.3}">
          <TextBlock Name="CcliLabel" Classes="label" Text="{Binding [setup-ccli-label], Source={x:Static s:Localizer.Instance}}" />
          <views:HintText Text="{Binding [ccli-licence-hint], Source={x:Static s:Localizer.Instance}}" />
          <TextBox Name="CcliNumber" Text="{Binding Church.CcliNumber}" MaxLength="12" MinWidth="160" HorizontalAlignment="Left"
                   AutomationProperties.LabeledBy="{Binding #CcliLabel}" />
          <TextBlock Name="DefaultBibleLabel" Classes="label" Text="{Binding [church-default-bible-label], Source={x:Static s:Localizer.Instance}}" />
          <views:HintText Text="{Binding [default-bible-hint], Source={x:Static s:Localizer.Instance}}" />
          <ComboBox Name="DefaultBible" MinWidth="200" ItemsSource="{Binding Church.Bibles}" SelectedItem="{Binding Church.SelectedBible}"
                    AutomationProperties.LabeledBy="{Binding #DefaultBibleLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pb:BibleTranslation"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Name="SaveChurch" HorizontalAlignment="Left" Command="{Binding Church.SaveCommand}">
            <TextBlock Text="{Binding [church-save], Source={x:Static s:Localizer.Instance}}" />
          </Button>
          <TextBlock Name="ChurchStatus" TextWrapping="Wrap" Text="{Binding Church.StatusText}"
                     IsVisible="{Binding Church.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Settings ▸ Updates (M1.11): off until the person turns it on; checks only when asked. -->
      <WrapPanel ItemSpacing="{DynamicResource Space.2}" VerticalAlignment="Center">
        <TextBlock Classes="title-3" VerticalAlignment="Center" Text="{Binding [settings-section-updates], Source={x:Static s:Localizer.Instance}}" />
        <views:InfoButton Anchor="settings.updates" />
      </WrapPanel>
      <Border Name="UpdatesCard" Classes="card" s:Help.Anchor="settings.updates">
        <StackPanel Spacing="{DynamicResource Space.3}">
          <ToggleSwitch Name="AllowUpdateCheck" IsChecked="{Binding Updates.AllowUpdateCheck}">
            <TextBlock Text="{Binding [updates-allow-label], Source={x:Static s:Localizer.Instance}}" />
          </ToggleSwitch>
          <views:HintText Text="{Binding [updates-allow-hint], Source={x:Static s:Localizer.Instance}}" />
          <TextBlock Name="UpdateFeedLabel" Classes="label" Text="{Binding [updates-feed-label], Source={x:Static s:Localizer.Instance}}" />
          <views:HintText Text="{Binding [updates-feed-hint], Source={x:Static s:Localizer.Instance}}" />
          <TextBox Name="UpdateFeedUrl" Text="{Binding Updates.FeedUrl}" AutomationProperties.LabeledBy="{Binding #UpdateFeedLabel}" />
          <WrapPanel ItemSpacing="{DynamicResource Space.3}" LineSpacing="{DynamicResource Space.3}">
            <Button Name="SaveUpdateFeed" Command="{Binding Updates.SaveAddressCommand}">
              <TextBlock Text="{Binding [updates-save], Source={x:Static s:Localizer.Instance}}" />
            </Button>
            <Button Name="CheckForUpdates" Classes="primary" Command="{Binding Updates.CheckCommand}">
              <TextBlock Text="{Binding [updates-check], Source={x:Static s:Localizer.Instance}}" />
            </Button>
            <Button Name="InstallUpdate" Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.CanInstall}">
              <TextBlock Text="{Binding [updates-install], Source={x:Static s:Localizer.Instance}}" />
            </Button>
          </WrapPanel>
          <TextBlock Name="UpdateMessage" TextWrapping="Wrap" Text="{Binding Updates.Message}"
                     IsVisible="{Binding Updates.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
