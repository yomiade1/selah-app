{
  "title": "Nothing but the Blood of Jesus",
  "author": "Robert Lowry (1826-1899)",
  "key": "G",
  "public_domain": true,
  "arrangement": [
    "Verse 1",
    "Chorus",
    "Verse 2",
    "Chorus",
    "Verse 3",
    "Chorus",
    "Verse 4",
    "Chorus"
  ],
  "sections": [
    {
      "label": "Verse 1",
      "kind": "verse",
      "color_hex": "#2378C3",
      "hotkey": "1",
      "lines": [
        {
          "text": "What can wash away my sin?",
          "chords": [
            {
              "position": 9,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus;",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        },
        {
          "text": "What can make me whole again?",
          "chords": [
            {
              "position": 9,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus.",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        }
      ]
    },
    {
      "label": "Chorus",
      "kind": "chorus",
      "color_hex": "#C84281",
      "hotkey": "C",
      "lines": [
        {
          "text": "O precious is the flow",
          "chords": [
            {
              "position": 2,
              "text": "G"
            }
          ]
        },
        {
          "text": "That makes me white as snow;",
          "chords": [
            {
              "position": 5,
              "text": "D"
            }
          ]
        },
        {
          "text": "No other fount I know,",
          "chords": [
            {
              "position": 3,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus.",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 2",
      "kind": "verse",
      "color_hex": "#2378C3",
      "hotkey": "2",
      "lines": [
        {
          "text": "For my pardon, this I see,",
          "chords": [
            {
              "position": 7,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus;",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        },
        {
          "text": "For my cleansing this my plea,",
          "chords": [
            {
              "position": 7,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus.",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 3",
      "kind": "verse",
      "color_hex": "#2378C3",
      "hotkey": "3",
      "lines": [
        {
          "text": "Nothing can for sin atone,",
          "chords": [
            {
              "position": 8,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus;",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        },
        {
          "text": "Naught of good that I have done,",
          "chords": [
            {
              "position": 10,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus.",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 4",
      "kind": "verse",
      "color_hex": "#2378C3",
      "hotkey": "4",
      "lines": [
        {
          "text": "This is all my hope and peace,",
          "chords": [
            {
              "position": 8,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus;",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        },
        {
          "text": "This is all my righteousness,",
          "chords": [
            {
              "position": 8,
              "text": "G"
            }
          ]
        },
        {
          "text": "Nothing but the blood of Jesus.",
          "chords": [
            {
              "position": 16,
              "text": "D"
            },
            {
              "position": 25,
              "text": "G"
            }
          ]
        }
      ]
    }
  ]
}
