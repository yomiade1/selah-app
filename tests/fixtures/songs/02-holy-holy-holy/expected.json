            {
              "position": 0,
              "text": "D"
            },
            {
              "position": 12,
              "text": "Bm"
            },
            {
              "position": 18,
              "text": "A"
            },
            {
              "position": 29,
              "text": "D"
            }
          ]
        },
        {
          "text": "Early in the morning our song shall rise to Thee;",
          "chords": [
            {
              "position": 0,
              "text": "G"
            },
            {
              "position": 13,
              "text": "D"
            },
            {
              "position": 25,
              "text": "A"
            }
          ]
        },
        {
          "text": "Holy, holy, holy! Merciful and mighty!",
          "chords": [
            {
              "position": 0,
              "text": "D"
            },
            {
              "position": 12,
              "text": "Bm"
            },
            {
              "position": 18,
              "text": "A"
            },
            {
              "position": 31,
              "text": "D"
            }
          ]
        },
        {
          "text": "God in three Persons, blessed Trinity!",
          "chords": [
            {
              "position": 0,
              "text": "Bm"
            },
            {
              "position": 13,
