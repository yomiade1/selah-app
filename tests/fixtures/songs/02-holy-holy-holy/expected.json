            },
            {
              "position": 35,
              "text": "D"
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 2",
      "kind": "verse",
      "color_hex": "#2378C3",
      "hotkey": "2",
      "lines": [
        {
          "text": "Holy, holy, holy! All the saints adore Thee,",
          "chords": [
            {
              "position": 0,
              "text": "D"
            },
            {
              "position": 12,
              "text": "Bm"
            },
            {
              "position": 18,
              "text": "A"
            },
            {
              "position": 34,
              "text": "D"
            }
          ]
        },
        {
          "text": "Casting down their golden crowns around the glassy sea;",
          "chords": [
            {
              "position": 0,
              "text": "G"
            },
            {
              "position": 19,
              "text": "D"
            },
            {
              "position": 34,
              "text": "A"
            }
          ]
        },
        {
          "text": "Cherubim and seraphim falling down before Thee,",
          "chords": [
            {
              "position": 0,
              "text": "D"
            },
            {
              "position": 13,
              "text": "Bm"
            },
            {
              "position": 22,
              "text": "A"
            },
            {
              "position": 37,
              "text": "D"
            }
          ]
        },
        {
          "text": "Who wert, and art, and evermore shalt be.",
          "chords": [
            {
              "position": 0,
              "text": "Bm"
            },
            {
              "position": 14,
              "text": "F#m"
            },
            {
              "position": 23,
              "text": "G"
            },
            {
              "position": 27,
              "text": "A"
            },
            {
              "position": 38,
              "text": "D"
            }
          ]
        }
      ]
    },
    {
      "label": "Verse 3",
      "kind": "verse",
      "color_hex": "#2378C3",
      "hotkey": "3",
      "lines": [
        {
          "text": "Holy, holy, holy! Though the darkness hide Thee,",
          "chords": [
            {
              "position": 0,
              "text": "D"
            },
            {
              "position": 12,
              "text": "Bm"
            },
            {
              "position": 18,
              "text": "A"
            },
            {
              "position": 38,
              "text": "D"
            }
          ]
        },
        {
          "text": "Though the eye of sinful man Thy glory may not see,",
          "chords": [
            {
              "position": 0,
              "text": "G"
            },
            {
              "position": 18,
              "text": "D"
            },
            {
              "position": 33,
              "text": "A"
            }
          ]
        },
        {
          "text": "Only Thou art holy; there is none beside Thee,",
          "chords": [
            {
              "position": 0,
              "text": "D"
            },
            {
              "position": 14,
              "text": "Bm"
            },
            {
              "position": 20,
              "text": "A"
            },
            {
              "position": 36,
              "text": "D"
            }
          ]
        },
        {
          "text": "Perfect in power, in love, and purity.",
          "chords": [
            {
              "position": 0,
              "text": "Bm"
            },
            {
              "position": 11,
              "text": "F#m"
            },
            {
