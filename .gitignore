# Starter ignore list; milestone 1 (M1.1) extends it.
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
/third_party/
/target/
node_modules/
.vs/
.idea/
/artifacts/

# Secrets and signing material never belong in the repository (docs/SECURITY.md §6).
.env
.env.*
*.pfx
*.p12
id_rsa*
id_ed25519*
# Build products and local tool caches
# .NET build output (Rust src/bin/ folders are source and stay tracked)
/app/**/bin/
/app/**/obj/
/app/**/TestResults/
**/node_modules/
/.tools/
/.cache/
/.pnpm-store/
__pycache__/
*.pyc
/tests/fixtures/media/generated/
**/dist/
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
